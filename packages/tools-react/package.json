{
  "name": "@devtools-mcp/tools-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Page-side React inspection tools (fiber-centric, via the React DevTools hook + bippy)",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./descriptors": { "types": "./src/descriptors.ts", "default": "./src/descriptors.ts" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@devtools-mcp/protocol": "workspace:*",
    "bippy": "0.7.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^28.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
